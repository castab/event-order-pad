POSTGRES_USER=order_pad
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=order_pad
POSTGRES_PORT=5432
# PostgreSQL 18 and the app service must run on this same machine.
DATABASE_URL=postgresql://order_pad:replace-with-a-local-password@127.0.0.1:5432/order_pad
# Set once to your deployment's UTC cutoff; retain across restarts.
ORDER_PAD_CAPTURE_FROM=2026-10-13T00:00:00.000Z
ORDER_PAD_ORIGIN=https://orders.example.com
# cloudflare trusts CF-Connecting-IP only from the local cloudflared connector.
# Use direct only when your HTTPS reverse proxy does not supply that header.
ORDER_PAD_PROXY=cloudflare
ORDER_PAD_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
ORDER_PAD_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
ORDER_PAD_QUEUE=OrderPad
ORDER_PAD_TRACKING_ENABLED=true
# Integration tests require a separate disposable database, never the station database.
TEST_DATABASE_URL=postgresql://order_pad:replace-with-a-local-password@127.0.0.1:5432/order_pad_test
