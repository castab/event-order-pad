generator client {
  provider = "prisma-client"
  output   = "../printer-service/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model OrderEvent {
  eventId    BigInt   @id @default(autoincrement()) @map("event_id")
  orderId    String   @map("order_id")
  occurredAt DateTime @db.Timestamptz(3) @map("occurred_at")
  eventType  String   @map("event_type")
  orderJsonb Json     @db.JsonB @map("order_jsonb")

  @@index([orderId, eventId(sort: Desc)], map: "order_events_latest_idx")
  @@map("order_events")
}

model Station {
  id Int @id
  referenceCounter BigInt @default(0) @map("reference_counter")
  @@map("station")
}

model Workspace {
  id String @id
  cookieId String? @unique @map("cookie_id")
  revision Int @default(0)
  draft Json @db.JsonB
  latestTicketId String? @map("latest_ticket_id")
  latestTicket Ticket? @relation("latest", fields: [latestTicketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tickets Ticket[] @relation("owner")
  @@map("workspaces")
}

model Ticket {
  id      String @id
  content Json   @db.JsonB
  attempts Attempt[]
  workspaceId String @map("workspace_id")
  workspace Workspace @relation("owner", fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  latestFor Workspace[] @relation("latest")

  @@map("tickets")
}

model Attempt {
  id       String @id
  ticketId String @map("ticket_id")
  content  Json   @db.JsonB
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dispatch PrintDispatch?

  @@index([ticketId])
  @@map("print_attempts")
}

model PrintDispatch {
  attemptId String @id @map("attempt_id")
  request   Json   @db.JsonB
  result    Json?  @db.JsonB
  completedAt DateTime? @db.Timestamptz(3) @map("completed_at")
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("print_dispatches")
}

model AuthUser {
  id String @id
  username String @unique
  passwordHash String? @map("password_hash")
  enabled Boolean @default(true)
  version Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  sessions AuthSession[]
  passkeys AuthPasskey[]
  workspaces AuthWorkspace[]
  @@map("auth_users")
}
model AuthSession {
  tokenHash String @id @map("token_hash")
  userId String @map("user_id")
  version Int
  authenticatedAt DateTime @db.Timestamptz(3) @map("authenticated_at")
  expiresAt DateTime @db.Timestamptz(3) @map("expires_at")
  user AuthUser @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}
model AuthPasskey {
  id String @id
  userId String @map("user_id")
  publicKey Bytes @map("public_key")
  counter BigInt
  transports String[]
  deviceType String @map("device_type")
  backedUp Boolean @map("backed_up")
  name String
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  user AuthUser @relation(fields: [userId], references: [id])
  @@index([userId])
  @@map("auth_passkeys")
}
model AuthChallenge {
  tokenHash String @id @map("token_hash")
  browserHash String @map("browser_hash")
  sessionHash String? @map("session_hash")
  userId String? @map("user_id")
  version Int?
  kind String
  challenge String
  expiresAt DateTime @db.Timestamptz(3) @map("expires_at")
  @@index([expiresAt])
  @@map("auth_challenges")
}
model AuthToken {
  tokenHash String @id @map("token_hash")
  username String
  kind String
  userId String? @map("user_id")
  expiresAt DateTime @db.Timestamptz(3) @map("expires_at")
  @@unique([kind, username])
  @@index([expiresAt])
  @@map("auth_tokens")
}
model AuthRate {
  key String @id
  count Int
  expiresAt DateTime @db.Timestamptz(3) @map("expires_at")
  @@index([expiresAt])
  @@map("auth_rates")
}
model AuthEvent {
  id BigInt @id @default(autoincrement())
  kind String
  userId String? @map("user_id")
  ipHash String? @map("ip_hash")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  @@index([createdAt])
  @@map("auth_events")
}
model AuthWorkspace {
  userId String @map("user_id")
  browserHash String @map("browser_hash")
  workspaceKey String @unique @map("workspace_key")
  user AuthUser @relation(fields: [userId], references: [id])
  @@id([userId, browserHash])
  @@map("auth_workspaces")
}
